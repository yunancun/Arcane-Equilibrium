{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_5_recovery_anchor_outbox_v1.schema.json",
  "title": "s2_5_recovery_anchor_outbox_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "transition_json", "transition_digest",
    "candidate_subject_digest", "prior_manifest_digest",
    "prepared_payload_json", "prepared_payload_digest", "request_digest",
    "idempotency_key", "expected_external_sequence",
    "expected_external_head_digest", "expected_snapshot_id",
    "expected_latest_version_id", "candidate_external_sequence",
    "prepared_at", "status", "effect_executed", "evidence_class",
    "side_effect_class", "target_class", "target_profile_id",
    "production_effect", "production_authority", "production_effect_count",
    "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_5_recovery_anchor_outbox_v1"},
    "transition_json": {"type": "string", "minLength": 2},
    "transition_digest": {"$ref": "#/$defs/digest"},
    "candidate_subject_digest": {"$ref": "#/$defs/digest"},
    "prior_manifest_digest": {"$ref": "#/$defs/nullableDigest"},
    "prepared_payload_json": {"type": "string", "minLength": 2},
    "prepared_payload_digest": {"$ref": "#/$defs/digest"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "idempotency_key": {"type": "string", "pattern": "^s2-5-anchor-idempotency-[0-9a-f]{64}$"},
    "expected_external_sequence": {"type": "integer", "minimum": 0},
    "expected_external_head_digest": {"$ref": "#/$defs/nullableDigest"},
    "expected_snapshot_id": {"type": "string", "minLength": 1},
    "expected_latest_version_id": {
      "anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
    },
    "candidate_external_sequence": {"type": "integer", "minimum": 1},
    "prepared_at": {"type": "string", "format": "date-time"},
    "status": {"const": "PREPARED_NO_EFFECT"},
    "effect_executed": {"const": false},
    "evidence_class": {"const": "LOCAL_REPRODUCIBLE"},
    "side_effect_class": {"const": "DISPOSABLE_TEST"},
    "target_class": {"const": "disposable_systemd"},
    "target_profile_id": {"const": "s2_5_recovery_user_systemd_disposable_v1"},
    "production_effect": {"const": false},
    "production_authority": {"const": false},
    "production_effect_count": {"const": 0},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
  }
}
