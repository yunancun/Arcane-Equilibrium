{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_5_recovery_anchor_proof_v1.schema.json",
  "title": "s2_5_recovery_anchor_proof_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "outbox_prepared_state_digest",
    "outbox_candidate_subject_digest",
    "confirmed_candidate_subject_digest", "transition_json",
    "transition_digest", "outbox_json", "outbox_digest",
    "idempotency_key", "source_head", "start_id", "phase", "object_id",
    "version_id", "checksum", "sequence", "previous_head_digest",
    "head_digest", "external_monotonic_floor", "snapshot_id",
    "latest_version_id", "exact_readback_digest", "enumeration_digest",
    "latest_digest", "writer_identity_digest", "reader_identity_digest",
    "verifier_identity_digest", "immutable_readback", "full_chain_valid",
    "identity_distinct", "authenticated_response", "failure_code",
    "evidence_class", "side_effect_class", "target_class",
    "target_profile_id", "production_effect", "production_authority",
    "production_effect_count", "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_5_recovery_anchor_proof_v1"},
    "outbox_prepared_state_digest": {"$ref": "#/$defs/digest"},
    "outbox_candidate_subject_digest": {"$ref": "#/$defs/digest"},
    "confirmed_candidate_subject_digest": {"$ref": "#/$defs/digest"},
    "transition_json": {"type": "string", "minLength": 2},
    "transition_digest": {"$ref": "#/$defs/digest"},
    "outbox_json": {"type": "string", "minLength": 2},
    "outbox_digest": {"$ref": "#/$defs/digest"},
    "idempotency_key": {"type": "string", "pattern": "^s2-5-anchor-idempotency-[0-9a-f]{64}$"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "start_id": {"type": "string", "pattern": "^s2-5-[0-9a-f]{64}$"},
    "phase": {"enum": ["PREPARED", "CONSUMED", "COMMITTED", "RESOLVED"]},
    "object_id": {"type": "string", "minLength": 1},
    "version_id": {"type": "string", "minLength": 1},
    "checksum": {"$ref": "#/$defs/digest"},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_head_digest": {"$ref": "#/$defs/nullableDigest"},
    "head_digest": {"$ref": "#/$defs/digest"},
    "external_monotonic_floor": {"type": "integer", "minimum": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "latest_version_id": {"type": "string", "minLength": 1},
    "exact_readback_digest": {"$ref": "#/$defs/digest"},
    "enumeration_digest": {"$ref": "#/$defs/digest"},
    "latest_digest": {"$ref": "#/$defs/digest"},
    "writer_identity_digest": {"$ref": "#/$defs/digest"},
    "reader_identity_digest": {"$ref": "#/$defs/digest"},
    "verifier_identity_digest": {"$ref": "#/$defs/digest"},
    "immutable_readback": {"const": false},
    "full_chain_valid": {"const": false},
    "identity_distinct": {"const": false},
    "authenticated_response": {"const": false},
    "failure_code": {"type": "string", "minLength": 1},
    "evidence_class": {"const": "LOCAL_REPRODUCIBLE"},
    "side_effect_class": {"const": "DISPOSABLE_TEST"},
    "target_class": {"const": "disposable_systemd"},
    "target_profile_id": {"const": "s2_5_recovery_user_systemd_disposable_v1"},
    "production_effect": {"const": false},
    "production_authority": {"const": false},
    "production_effect_count": {"const": 0},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
  }
}
