{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_5_recovery_anchor_rollback_v1.schema.json",
  "title": "s2_5_recovery_anchor_rollback_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "anchor_store_id", "anchor_collection_id",
    "intent_digest", "result_digest", "status", "immutable_anchor_deleted",
    "deletion_attempted", "operator_action_required", "reason", "completed_at",
    "evidence_class", "side_effect_class", "target_class", "target_profile_id",
    "production_effect", "production_authority", "production_effect_count",
    "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_5_recovery_anchor_rollback_v1"},
    "anchor_store_id": {"const": "s2-5-recovery-external-anchor-v1"},
    "anchor_collection_id": {"const": "s2-5-recovery-anchor-chain-v1"},
    "intent_digest": {"$ref": "#/$defs/digest"},
    "result_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["NOT_REQUIRED", "RECOVERY_REQUIRED"]},
    "immutable_anchor_deleted": {"const": false},
    "deletion_attempted": {"const": false},
    "operator_action_required": {"type": "boolean"},
    "reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "completed_at": {"type": "string", "format": "date-time"},
    "evidence_class": {"const": "LOCAL_REPRODUCIBLE"},
    "side_effect_class": {"const": "DISPOSABLE_TEST"},
    "target_class": {"const": "disposable_systemd"},
    "target_profile_id": {"const": "s2_5_recovery_user_systemd_disposable_v1"},
    "production_effect": {"const": false},
    "production_authority": {"const": false},
    "production_effect_count": {"const": 0},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
