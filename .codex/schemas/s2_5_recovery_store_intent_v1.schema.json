{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_5_recovery_store_intent_v1.schema.json",
  "title": "s2_5_recovery_store_intent_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "store_id", "state_root_id", "source_head", "operation",
    "expected_previous_manifest_digest", "candidate_manifest_digest",
    "issued_at", "expires_at", "recovery_lock_intent_digest",
    "recovery_lock_result_digest", "recovery_lock_postcheck_digest",
    "recovery_lock_chain_digest", "session_class", "store_write_authority",
    "side_effect_class", "target_class",
    "target_profile_id", "production_effect", "production_authority",
    "production_effect_count",
    "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_5_recovery_store_intent_v1"},
    "store_id": {"type": "string", "pattern": "^s2-5-store-[0-9a-f]{64}$"},
    "state_root_id": {"$ref": "#/$defs/digest"},
    "source_head": {"$ref": "#/$defs/head"},
    "operation": {"enum": ["PREPARE", "PROMOTE", "RESOLVE", "ROLLBACK"]},
    "expected_previous_manifest_digest": {"$ref": "#/$defs/nullableDigest"},
    "candidate_manifest_digest": {"$ref": "#/$defs/digest"},
    "issued_at": {
      "type": "string", "format": "date-time",
      "description": "Timezone-aware start of the closed positive TTL window."
    },
    "expires_at": {
      "type": "string", "format": "date-time",
      "description": "Must be later than issued_at and no more than 300 seconds later; enforced by validate_local_artifact."
    },
    "recovery_lock_intent_digest": {"$ref": "#/$defs/digest"},
    "recovery_lock_result_digest": {"$ref": "#/$defs/digest"},
    "recovery_lock_postcheck_digest": {"$ref": "#/$defs/digest"},
    "recovery_lock_chain_digest": {"$ref": "#/$defs/digest"},
    "session_class": {
      "enum": ["SIMULATION_ONLY", "FIXED_POSIX_RECOVERY_SESSION"]
    },
    "store_write_authority": {"type": "boolean"},
    "side_effect_class": {"const": "DISPOSABLE_TEST"},
    "target_class": {"const": "disposable_systemd"},
    "target_profile_id": {
      "const": "s2_5_recovery_user_systemd_disposable_v1"
    },
    "production_effect": {"const": false},
    "production_authority": {"const": false},
    "production_effect_count": {"const": 0},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
