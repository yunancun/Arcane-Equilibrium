{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_5_recovery_anchor_entry_v1.schema.json",
  "title": "s2_5_recovery_anchor_entry_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "store_id", "state_root_id", "source_head", "sequence",
    "previous_anchor_digest", "manifest_digest", "unresolved_state_digest",
    "authorization_id", "entry_status", "append_actor_identity",
    "readback_verifier_identity", "side_effect_class", "target_class",
    "target_profile_id", "production_effect", "production_authority",
    "production_effect_count",
    "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_5_recovery_anchor_entry_v1"},
    "store_id": {"type": "string", "pattern": "^s2-5-store-[0-9a-f]{64}$"},
    "state_root_id": {"$ref": "#/$defs/digest"},
    "source_head": {"$ref": "#/$defs/head"},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_anchor_digest": {"$ref": "#/$defs/nullableDigest"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "unresolved_state_digest": {"$ref": "#/$defs/nullableDigest"},
    "authorization_id": {
      "anyOf": [
        {"type": "string", "pattern": "^s2-5-auth-[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "entry_status": {"enum": ["PREPARED", "COMMITTED", "CONSUMED", "RESOLVED"]},
    "append_actor_identity": {"type": "string", "minLength": 1},
    "readback_verifier_identity": {"type": "string", "minLength": 1},
    "side_effect_class": {"const": "DISPOSABLE_TEST"},
    "target_class": {"const": "disposable_systemd"},
    "target_profile_id": {
      "const": "s2_5_recovery_user_systemd_disposable_v1"
    },
    "production_effect": {"const": false},
    "production_authority": {"const": false},
    "production_effect_count": {"const": 0},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"const": 1}}},
      "then": {"properties": {"previous_anchor_digest": {"type": "null"}}},
      "else": {"properties": {"previous_anchor_digest": {"$ref": "#/$defs/digest"}}}
    },
    {
      "if": {"properties": {"entry_status": {"const": "CONSUMED"}}},
      "then": {"properties": {
        "authorization_id": {
          "type": "string",
          "pattern": "^s2-5-auth-[0-9a-f]{64}$"
        }
      }}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
