{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_liveness_adjudication_v1.schema.json",
  "title": "Unverified development-agent liveness adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "liveness_state",
    "primary_evidence",
    "activity_verification_status",
    "activity_verification_reason",
    "activity_state",
    "activity_observed_at",
    "adjudicated_at",
    "activity_freshness",
    "liveness_policy_id",
    "liveness_policy_digest",
    "max_observation_age_seconds",
    "diagnostic_state",
    "transcript_diagnostic",
    "automatic_stop"
  ],
  "properties": {
    "schema_version": {
      "const": "agent_liveness_adjudication_v1"
    },
    "liveness_state": {
      "const": "UNKNOWN"
    },
    "primary_evidence": {
      "const": "CALLER_ACTIVITY_UNVERIFIED"
    },
    "activity_verification_status": {
      "const": "EXTERNAL_LIMIT"
    },
    "activity_verification_reason": {
      "const": "MANAGED_HOST_ACTIVITY_ADAPTER_UNAVAILABLE"
    },
    "activity_state": {
      "enum": [
        "RUNNING",
        "WAITING",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "UNAVAILABLE"
      ]
    },
    "activity_observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "adjudicated_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "pattern": "Z$"
    },
    "activity_freshness": {
      "enum": ["FRESH", "STALE", "FUTURE", "UNVERIFIABLE"]
    },
    "liveness_policy_id": {
      "const": "supported_activity_freshness_v1"
    },
    "liveness_policy_digest": {
      "const": "sha256:db265e286f3e4275e9f721759c6b70adb4c34375f5d21441484ee5aedd5687fb"
    },
    "max_observation_age_seconds": {
      "const": 60
    },
    "diagnostic_state": {
      "enum": ["AVAILABLE", "UNAVAILABLE", "RUNAWAY_SUSPECT"]
    },
    "transcript_diagnostic": {
      "$ref": "#/$defs/private_jsonl_liveness_diagnostic_v1"
    },
    "automatic_stop": {
      "const": false
    }
  },
  "$defs": {
    "private_jsonl_liveness_diagnostic_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "exists",
        "size_bytes",
        "mtime_ms"
      ],
      "properties": {
        "schema_version": {
          "const": "private_jsonl_liveness_diagnostic_v1"
        },
        "exists": {
          "type": "boolean"
        },
        "size_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "mtime_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exists": {
                "const": false
              }
            },
            "required": ["exists"]
          },
          "then": {
            "properties": {
              "size_bytes": {
                "type": "null"
              },
              "mtime_ms": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "mtime_ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    }
  }
}
