{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_5_recovery_store_result_v1.schema.json",
  "title": "s2_5_recovery_store_result_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "intent_digest", "status", "manifest_digest",
    "file_fsynced", "atomic_replace", "directory_fsynced",
    "parent_identity_rechecked", "failure_code", "side_effect_class",
    "target_class", "target_profile_id", "production_effect", "production_authority",
    "production_effect_count", "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_5_recovery_store_result_v1"},
    "intent_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["COMMITTED", "EXTERNAL_VERIFICATION_PENDING", "RECOVERY_REQUIRED", "REJECTED"]},
    "manifest_digest": {"$ref": "#/$defs/nullableDigest"},
    "file_fsynced": {"type": "boolean"},
    "atomic_replace": {"type": "boolean"},
    "directory_fsynced": {"type": "boolean"},
    "parent_identity_rechecked": {"type": "boolean"},
    "failure_code": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "side_effect_class": {"const": "DISPOSABLE_TEST"},
    "target_class": {"const": "disposable_systemd"},
    "target_profile_id": {
      "const": "s2_5_recovery_user_systemd_disposable_v1"
    },
    "production_effect": {"const": false},
    "production_authority": {"const": false},
    "production_effect_count": {"const": 0},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
  }
}
