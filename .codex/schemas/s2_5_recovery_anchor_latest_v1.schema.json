{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_5_recovery_anchor_latest_v1.schema.json",
  "title": "s2_5_recovery_anchor_latest_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "anchor_store_id", "anchor_collection_id", "store_id",
    "state_root_id", "source_head", "snapshot_id", "latest_version_id",
    "sequence", "head_digest", "head_object_id", "head_version_id",
    "entry_count", "page_count", "page_size", "issued_at", "expires_at",
    "signer_identity", "evidence_class", "side_effect_class", "target_class",
    "target_profile_id", "production_effect", "production_authority",
    "production_effect_count", "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_5_recovery_anchor_latest_v1"},
    "anchor_store_id": {"const": "s2-5-recovery-external-anchor-v1"},
    "anchor_collection_id": {"const": "s2-5-recovery-anchor-chain-v1"},
    "store_id": {"type": "string", "pattern": "^s2-5-store-[0-9a-f]{64}$"},
    "state_root_id": {"$ref": "#/$defs/digest"},
    "source_head": {"$ref": "#/$defs/head"},
    "snapshot_id": {"$ref": "#/$defs/digest"},
    "latest_version_id": {
      "type": "string", "pattern": "^s2-5-anchor-version-[0-9a-f]{64}$"
    },
    "sequence": {"type": "integer", "minimum": 0},
    "head_digest": {"$ref": "#/$defs/nullableDigest"},
    "head_object_id": {
      "anyOf": [
        {"type": "string", "pattern": "^s2-5-anchor-object-[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "head_version_id": {
      "anyOf": [
        {"type": "string", "pattern": "^s2-5-anchor-version-[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "entry_count": {"type": "integer", "minimum": 0},
    "page_count": {"type": "integer", "minimum": 0},
    "page_size": {"type": "integer", "minimum": 1, "maximum": 1000},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signer_identity": {"$ref": "#/$defs/identity"},
    "evidence_class": {"const": "LOCAL_REPRODUCIBLE"},
    "side_effect_class": {"const": "DISPOSABLE_TEST"},
    "target_class": {"const": "disposable_systemd"},
    "target_profile_id": {"const": "s2_5_recovery_user_systemd_disposable_v1"},
    "production_effect": {"const": false},
    "production_authority": {"const": false},
    "production_effect_count": {"const": 0},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "unit", "cgroup", "key_fingerprint"],
      "properties": {
        "role": {"const": "external_anchor_reader"},
        "unit": {"const": "arcane-equilibrium-aiml-s2-5-anchor-reader.service"},
        "cgroup": {
          "const": "/user.slice/user-1000.slice/user@1000.service/app.slice/arcane-equilibrium-aiml-s2-5-anchor-reader.service"
        },
        "key_fingerprint": {"type": "null"}
      }
    }
  }
}
