{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_5_recovery_store_rollback_v1.schema.json",
  "title": "s2_5_recovery_store_rollback_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "intent_digest", "result_digest", "status",
    "restored_manifest_digest", "temp_residue_absent", "operator_action_required",
    "session_class", "store_write_authority",
    "side_effect_class", "target_class", "production_effect",
    "target_profile_id", "production_authority", "production_effect_count",
    "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_5_recovery_store_rollback_v1"},
    "intent_digest": {"$ref": "#/$defs/digest"},
    "result_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["NOT_REQUIRED", "ROLLED_BACK", "RECOVERY_REQUIRED"]},
    "restored_manifest_digest": {"$ref": "#/$defs/nullableDigest"},
    "temp_residue_absent": {"type": "boolean"},
    "operator_action_required": {"type": "boolean"},
    "session_class": {
      "enum": ["SIMULATION_ONLY", "FIXED_POSIX_RECOVERY_SESSION"]
    },
    "store_write_authority": {"type": "boolean"},
    "side_effect_class": {"const": "DISPOSABLE_TEST"},
    "target_class": {"const": "disposable_systemd"},
    "target_profile_id": {
      "const": "s2_5_recovery_user_systemd_disposable_v1"
    },
    "production_effect": {"const": false},
    "production_authority": {"const": false},
    "production_effect_count": {"const": 0},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "NOT_REQUIRED"}}},
      "then": {"properties": {
        "restored_manifest_digest": {"type": "null"},
        "temp_residue_absent": {"const": true},
        "operator_action_required": {"const": false}
      }}
    },
    {
      "if": {"properties": {"status": {"const": "ROLLED_BACK"}}},
      "then": {"properties": {
        "restored_manifest_digest": {"$ref": "#/$defs/digest"},
        "temp_residue_absent": {"const": true},
        "operator_action_required": {"const": false}
      }}
    },
    {
      "if": {"properties": {"status": {"const": "RECOVERY_REQUIRED"}}},
      "then": {"properties": {
        "restored_manifest_digest": {"type": "null"},
        "operator_action_required": {"const": true}
      }}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
  }
}
