{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_5_recovery_store_manifest_v2.schema.json",
  "title": "s2_5_recovery_store_manifest_v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "store_id", "stable_root_id", "state_root_id",
    "source_head", "generation", "phase", "anchor_progress",
    "previous_manifest_digest", "controller_state",
    "controller_state_digest", "pending_outbox", "pending_outbox_digest",
    "attached_anchor_proof", "attached_anchor_proof_digest",
    "state_root_identity", "journal_inventory", "journal_set_digest",
    "replay_ledger", "trust_status", "side_effect_class", "target_class",
    "target_profile_id", "production_effect", "production_authority",
    "production_effect_count", "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_5_recovery_store_manifest_v2"},
    "store_id": {"type": "string", "pattern": "^s2-5-store-[0-9a-f]{64}$"},
    "stable_root_id": {"$ref": "#/$defs/digest"},
    "state_root_id": {"$ref": "#/$defs/digest"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generation": {"type": "integer", "minimum": 1},
    "phase": {"enum": ["PREPARED", "CONSUMED", "COMMITTED", "RESOLVED"]},
    "anchor_progress": {"enum": ["OUTBOX_PREPARED", "PROOF_ATTACHED_UNVERIFIED"]},
    "previous_manifest_digest": {"$ref": "#/$defs/nullableDigest"},
    "controller_state": {"type": "object"},
    "controller_state_digest": {"$ref": "#/$defs/digest"},
    "pending_outbox": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "pending_outbox_digest": {"$ref": "#/$defs/nullableDigest"},
    "attached_anchor_proof": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "attached_anchor_proof_digest": {"$ref": "#/$defs/nullableDigest"},
    "state_root_identity": {"type": "object"},
    "journal_inventory": {"type": "array", "items": {"type": "object"}},
    "journal_set_digest": {"$ref": "#/$defs/digest"},
    "replay_ledger": {"type": "object"},
    "trust_status": {"const": "UNVERIFIED_EXTERNAL_ANCHOR_REQUIRED"},
    "side_effect_class": {"const": "DISPOSABLE_TEST"},
    "target_class": {"const": "disposable_systemd"},
    "target_profile_id": {"const": "s2_5_recovery_user_systemd_disposable_v1"},
    "production_effect": {"const": false},
    "production_authority": {"const": false},
    "production_effect_count": {"const": 0},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
  }
}
