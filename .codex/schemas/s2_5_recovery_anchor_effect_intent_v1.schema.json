{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_5_recovery_anchor_effect_intent_v1.schema.json",
  "title": "s2_5_recovery_anchor_effect_intent_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "outbox_prepared_state_digest",
    "manifest_discriminator_digest", "outbox_digest",
    "transition_digest", "request_digest", "idempotency_key", "source_head",
    "start_id", "phase", "candidate_external_sequence", "checked_at",
    "evidence_class", "side_effect_class", "target_class", "target_profile_id",
    "production_effect", "production_authority", "production_effect_count",
    "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_5_recovery_anchor_effect_intent_v1"},
    "outbox_prepared_state_digest": {"$ref": "#/$defs/digest"},
    "manifest_discriminator_digest": {"$ref": "#/$defs/digest"},
    "outbox_digest": {"$ref": "#/$defs/digest"},
    "transition_digest": {"$ref": "#/$defs/digest"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "idempotency_key": {"type": "string", "pattern": "^s2-5-anchor-idempotency-[0-9a-f]{64}$"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "start_id": {"type": "string", "pattern": "^s2-5-[0-9a-f]{64}$"},
    "phase": {"enum": ["PREPARED", "CONSUMED", "COMMITTED", "RESOLVED"]},
    "candidate_external_sequence": {"type": "integer", "minimum": 1},
    "checked_at": {"type": "string", "format": "date-time"},
    "evidence_class": {"const": "LOCAL_REPRODUCIBLE"},
    "side_effect_class": {"const": "DISPOSABLE_TEST"},
    "target_class": {"const": "disposable_systemd"},
    "target_profile_id": {"const": "s2_5_recovery_user_systemd_disposable_v1"},
    "production_effect": {"const": false},
    "production_authority": {"const": false},
    "production_effect_count": {"const": 0},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
