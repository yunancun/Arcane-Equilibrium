  },
  "datasets": [
    {"name": "kline", "endpoint": "/v5/market/kline", "params": {"category": "linear", "limit": 1000}, "intervals": ["60", "D"], "symbols": "universe", "window_keys": ["start", "end"]},
    {"name": "kline", "endpoint": "/v5/market/kline", "params": {"category": "linear", "limit": 1000}, "intervals": ["1"], "symbols": ["BTCUSDT", "ETHUSDT"], "window_keys": ["start", "end"]},
    {"name": "funding", "endpoint": "/v5/market/funding/history", "params": {"category": "linear", "limit": 200}, "symbols": "universe", "window_keys": ["startTime", "endTime"]},
    {"name": "open_interest", "endpoint": "/v5/market/open-interest", "params": {"category": "linear", "limit": 200, "intervalTime": "4h"}, "symbols": "universe", "window_keys": ["startTime", "endTime"], "pagination_keys": ["cursor"]}
  ]
