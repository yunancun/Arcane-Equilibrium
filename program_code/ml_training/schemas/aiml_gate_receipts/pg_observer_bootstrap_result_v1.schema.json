{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/pg_observer_bootstrap_result_v1.schema.json",
  "title": "pg_observer_bootstrap_result_v1",
  "description": "Canonical self-hashed result of one S2.0 observer bootstrap apply. Production apply is reachable but authority-locked: without a valid operator SSHSIG, or with no host production driver (Mac/source/tests), it is EXTERNAL_VERIFICATION_PENDING with zero mutation, never a fake success. APPLIED (production_apply_performed=true) is emitted ONLY by a real Linux host driver returning PLATFORM_ATTESTED apply+postcheck evidence; a disposable_local apply against a throwaway cluster is a real APPLIED_ROLLED_BACK_EXACT logic proof. The boundary keeps production_apply_performed false for every status except APPLIED, production_running_attested/load_verified false and the nine authorities false; no secret is serialized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "status",
    "intent_id",
    "intent_digest",
    "target_class",
    "target_host",
    "endpoint",
    "database",
    "observer_role",
    "auth_mapping",
    "observed_schema",
    "observed_relations",
    "grant_set_selector",
    "grant_set_digest",
    "pre_state_digest",
    "applied_grant_set_digest",
    "independent_postcheck",
    "rollback_record",
    "operator_authorization",
    "operator_signature_pem",
    "apply_actor_node",
    "independent_verifier_node",
    "source_head",
    "evidence_class",
    "boundary",
    "started_at",
    "completed_at",
    "evidence_expires_at",
    "ttl_seconds",
    "failure_reason",
    "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "pg_observer_bootstrap_result_v1"},
    "adapter_id": {"const": "pg_observer_bootstrap_adapter_v1"},
    "status": {
      "enum": [
        "APPLIED",
        "APPLIED_ROLLED_BACK_EXACT",
        "ROLLED_BACK_INTERRUPTED",
        "NOT_RESTORED_FAILED",
        "EXTERNAL_VERIFICATION_PENDING",
        "FAILED"
      ]
    },
    "intent_id": {"$ref": "#/$defs/digest"},
    "intent_digest": {"$ref": "#/$defs/digest"},
    "target_class": {"enum": ["disposable_local", "production"]},
    "target_host": {"type": "string", "minLength": 1},
    "endpoint": {"$ref": "#/$defs/endpoint"},
    "database": {"type": "string", "minLength": 1},
    "observer_role": {"$ref": "#/$defs/pg_ident"},
    "auth_mapping": {"enum": ["pg_hba_ident_local", "pg_hba_peer_local"]},
    "observed_schema": {"$ref": "#/$defs/pg_ident"},
    "observed_relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pg_ident"}},
    "grant_set_selector": {"const": "observer_read_only_v1"},
    "grant_set_digest": {"$ref": "#/$defs/digest"},
    "pre_state_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "applied_grant_set_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "independent_postcheck": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "rollback_record": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "operator_authorization": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "operator_signature_pem": {"anyOf": [{"type": "string", "pattern": "^-----BEGIN SSH SIGNATURE-----\\n[A-Za-z0-9+/=\\n]+-----END SSH SIGNATURE-----\\n?$"}, {"type": "null"}]},
    "apply_actor_node": {"type": "string", "minLength": 1},
    "independent_verifier_node": {"type": "string", "minLength": 1},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evidence_class": {"enum": ["LOCAL_REPRODUCIBLE", "STRUCTURAL_ONLY", "PLATFORM_ATTESTED"]},
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_apply_performed",
        "production_running_attested",
        "load_verified",
        "nine_authorities_false"
      ],
      "properties": {
        "production_apply_performed": {"type": "boolean"},
        "production_running_attested": {"const": false},
        "load_verified": {"const": false},
        "nine_authorities_false": {"const": true}
      }
    },
    "started_at": {"$ref": "#/$defs/timestamp"},
    "completed_at": {"$ref": "#/$defs/timestamp"},
    "evidence_expires_at": {"$ref": "#/$defs/timestamp"},
    "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "failure_reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"required": ["status"], "properties": {"status": {"const": "APPLIED"}}},
      "then": {
        "properties": {
          "target_class": {"const": "production"},
          "evidence_class": {"const": "PLATFORM_ATTESTED"},
          "pre_state_digest": {"$ref": "#/$defs/digest"},
          "applied_grant_set_digest": {"$ref": "#/$defs/digest"},
          "independent_postcheck": {"type": "object"},
          "rollback_record": {"type": "null"},
          "operator_authorization": {"type": "object"},
          "operator_signature_pem": {"type": "string", "pattern": "^-----BEGIN SSH SIGNATURE-----\\n[A-Za-z0-9+/=\\n]+-----END SSH SIGNATURE-----\\n?$"},
          "failure_reason": {"type": "null"},
          "boundary": {"properties": {"production_apply_performed": {"const": true}}}
        }
      },
      "else": {
        "properties": {
          "boundary": {"properties": {"production_apply_performed": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "APPLIED_ROLLED_BACK_EXACT"}}},
      "then": {
        "properties": {
          "target_class": {"const": "disposable_local"},
          "evidence_class": {"const": "LOCAL_REPRODUCIBLE"},
          "pre_state_digest": {"$ref": "#/$defs/digest"},
          "applied_grant_set_digest": {"$ref": "#/$defs/digest"},
          "independent_postcheck": {"type": "object"},
          "rollback_record": {"type": "object"},
          "operator_authorization": {"type": "object"},
          "operator_signature_pem": {"type": "string", "pattern": "^-----BEGIN SSH SIGNATURE-----\\n[A-Za-z0-9+/=\\n]+-----END SSH SIGNATURE-----\\n?$"},
          "failure_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "EXTERNAL_VERIFICATION_PENDING"}}},
      "then": {
        "properties": {
          "failure_reason": {"type": "string", "minLength": 1},
          "independent_postcheck": {"type": "null"},
          "rollback_record": {"type": "null"},
          "operator_signature_pem": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "pg_ident": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_class", "socket_dir", "loopback_host", "port"],
      "properties": {
        "endpoint_class": {"enum": ["unix_socket_allowlisted", "authenticated_loopback"]},
        "socket_dir": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "loopback_host": {"anyOf": [{"enum": ["127.0.0.1", "::1"]}, {"type": "null"}]},
        "port": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 65535}, {"type": "null"}]}
      }
    }
  }
}
