{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_4_install_rollback_v1.schema.json",
  "title": "s2_4_install_rollback_v1",
  "description": "Aggregate reverse compensation-chain contract for one S2.4 APPLY transaction (§5.4). Its signed digest is authority only for ownership-aware reverse-order compensation of this exact plan: unit -> launch/application bundle -> base runtime -> credential -> auth/PG -> host directories/identity. reverse_ops lists the five APPLY component classes in reverse install order, each with its per-row rollback digest and ownership confirmation. It restores exact non-secret captured prior bytes or removes only task-owned deltas whose pre-state proved absent; it never drops aiml_observer_ro and never reads/serializes/reconstructs a pre-existing secret. status==COMPENSATED_EXACT requires ownership-aware exact pre-state restoration; when safe exact compensation is impossible it emits RECOVERY_REQUIRED and blocks S2.5.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "plan_id",
    "plan_core_digest",
    "pre_state_digest",
    "post_state_digest",
    "reverse_ops",
    "ownership_aware",
    "exact_pre_state_restored",
    "daemon_reload_reasserted",
    "hba_reload_reasserted",
    "observer_role_preserved",
    "no_secret_reconstructed",
    "observed_at",
    "expires_at",
    "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_4_install_rollback_v1"},
    "status": {"enum": ["COMPENSATED_EXACT", "RECOVERY_REQUIRED", "NOT_COMPENSATED"]},
    "plan_id": {"$ref": "#/$defs/plan_id"},
    "plan_core_digest": {"$ref": "#/$defs/digest"},
    "pre_state_digest": {"$ref": "#/$defs/digest"},
    "post_state_digest": {"$ref": "#/$defs/digest"},
    "reverse_ops": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/reverse_op"}
    },
    "ownership_aware": {"type": "boolean"},
    "exact_pre_state_restored": {"type": "boolean"},
    "daemon_reload_reasserted": {"type": "boolean"},
    "hba_reload_reasserted": {"type": "boolean"},
    "observer_role_preserved": {"const": true},
    "no_secret_reconstructed": {"const": true},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "COMPENSATED_EXACT"}}},
      "then": {
        "properties": {
          "ownership_aware": {"const": true},
          "exact_pre_state_restored": {"const": true}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "plan_id": {"type": "string", "pattern": "^s2-4-[0-9a-f]{64}$"},
    "component_effect_class": {
      "enum": [
        "HOST_IDENTITY_INSTALL",
        "PG_ROLE_ACL_MIGRATION",
        "CREDENTIAL_INSTALL",
        "LEARNING_RUNTIME",
        "ENGINE_SCANNER"
      ]
    },
    "reverse_op": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_effect_class", "per_row_rollback_digest", "ownership_verified"],
      "properties": {
        "component_effect_class": {"$ref": "#/$defs/component_effect_class"},
        "per_row_rollback_digest": {"$ref": "#/$defs/digest"},
        "ownership_verified": {"type": "boolean"}
      }
    }
  }
}
