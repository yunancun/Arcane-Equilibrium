{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aiml_component_effect_classification_v2.schema.json",
  "title": "Classifier-derived AIML component effect classification (S2.4 WP4 install seams)",
  "description": "Additive sibling of aiml_component_effect_classification_v1 for the seven S2.4 install-source-seam component effect classes. required_effects is derived from the validator-resident AIML_COMPONENT_EFFECT_CLASS_MATRIX_V2, never from the caller; a work-package touching an effectful S2.4 component surface cannot self-declare it as source-only. The frozen S0.3 aiml_required_effect_classification_v1 classifier and the v1 component matrix/schema are NOT mutated by this sibling. The central validator dispatches by exact schema_version and rejects cross-version digests. required_effects.effect_class permits NONE only so a forged source-only downgrade is representable and rejected by the recompute in validate_aiml_artifact. adapter_binding_status carries the single v2 binding value AUTHORITY_LOCKED_PRODUCTION_CAPABLE (reachable contract enforcement plus authority-lock; a runnable host-driver ABI is later-wave and never implied here).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classification_id", "component_work_package_id", "classified_inputs", "classifier_digest", "required_effects", "classified_at", "self_digest"],
  "properties": {
    "schema_version": {"const": "aiml_component_effect_classification_v2"},
    "classification_id": {"$ref": "#/$defs/digest"},
    "component_work_package_id": {"type": "string", "minLength": 1},
    "classified_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_work_package_id", "component_effect_class", "declared_adapter_id", "declared_intent_fields", "owned_path_manifest", "direct_interfaces"],
      "properties": {
        "component_work_package_id": {"type": "string", "minLength": 1},
        "component_effect_class": {"enum": ["HOST_CAPABILITY_PROBE", "HOST_IDENTITY_INSTALL", "PG_ROLE_ACL_MIGRATION", "CREDENTIAL_INSTALL", "LEARNING_RUNTIME_PREPARE", "LEARNING_RUNTIME", "ENGINE_SCANNER"]},
        "declared_adapter_id": {"type": "string", "minLength": 1},
        "declared_intent_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "owned_path_manifest": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "direct_interfaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "classifier_digest": {"$ref": "#/$defs/digest"},
    "required_effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effect_class", "status", "adapter_id", "actor_node_id", "rollback_contract", "independent_postcheck_node_id", "required_intent_fields", "adapter_binding_status"],
        "properties": {
          "effect_class": {"enum": ["NONE", "HOST_CAPABILITY_PROBE", "HOST_IDENTITY_INSTALL", "PG_ROLE_ACL_MIGRATION", "CREDENTIAL_INSTALL", "LEARNING_RUNTIME_PREPARE", "LEARNING_RUNTIME", "ENGINE_SCANNER"]},
          "status": {"enum": ["REQUIRED_PENDING", "NOT_REQUIRED", "SATISFIED"]},
          "adapter_id": {"type": "string", "minLength": 1},
          "actor_node_id": {"type": "string", "minLength": 1},
          "rollback_contract": {"type": "string", "minLength": 1},
          "independent_postcheck_node_id": {"type": "string", "minLength": 1},
          "required_intent_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "adapter_binding_status": {"enum": ["AUTHORITY_LOCKED_PRODUCTION_CAPABLE"]}
        }
      }
    },
    "classified_at": {"$ref": "#/$defs/timestamp"},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
