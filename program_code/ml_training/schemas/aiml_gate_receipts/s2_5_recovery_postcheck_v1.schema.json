{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_5_recovery_postcheck_v1.schema.json",
  "title": "s2_5_recovery_postcheck_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "recovery_id", "recovery_intent_digest", "recovery_result_digest",
    "recovery_binding", "verifier_identity", "verifier_process", "verifier_capture_digest",
    "verifier_capture",
    "observed_state", "observed_state_digest", "status", "postcheck_id", "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_5_recovery_postcheck_v1"},
    "recovery_id": {"type": "string", "pattern": "^s2-5-recovery-[0-9a-f]{64}$"},
    "recovery_intent_digest": {"$ref": "#/$defs/digest"},
    "recovery_result_digest": {"$ref": "#/$defs/digest"},
    "recovery_binding": {"$ref": "#/$defs/recovery_binding_shape"},
    "verifier_identity": {"$ref": "#/$defs/node_identity"},
    "verifier_process": {"$ref": "#/$defs/process_identity"},
    "verifier_capture_digest": {"$ref": "#/$defs/digest"},
    "verifier_capture": {"$ref": "#/$defs/capture_shape"},
    "observed_state": {"$ref": "#/$defs/unit_state"},
    "observed_state_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["RECOVERY_CLEARED", "RECOVERY_UNRESOLVED"]},
    "postcheck_id": {"$ref": "#/$defs/digest"},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "recovery_binding_shape": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_digest", "unresolved_state_digest", "state_root_identity",
        "journal_set", "replay_ledger_head", "pre_state", "source_head",
        "host_identity", "authorization", "trusted_anchor", "actor_identity",
        "actor_process", "kernel_binding_digest", "admission_digest",
        "side_effect_class", "production_effect", "production_authority",
        "target_class"
      ],
      "properties": {
        "task_digest": {}, "unresolved_state_digest": {}, "state_root_identity": {},
        "journal_set": {}, "replay_ledger_head": {}, "pre_state": {},
        "source_head": {}, "host_identity": {}, "authorization": {},
        "trusted_anchor": {}, "actor_identity": {}, "actor_process": {},
        "kernel_binding_digest": {}, "admission_digest": {},
        "side_effect_class": {}, "production_effect": {},
        "production_authority": {}, "target_class": {}
      }
    },
    "capture_shape": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "capture_kind", "source_head", "host_identity",
        "bound_state_root_id", "recovery_id", "recovery_intent_digest",
        "recovery_result_digest", "observed_state", "observed_state_digest",
        "node_identity", "process_identity", "observed_at", "signer_identity",
        "signer_fingerprint", "signature_namespace", "signed_binding",
        "sshsig_armored", "capture_digest"
      ],
      "properties": {
        "schema_version": {}, "capture_kind": {}, "source_head": {},
        "host_identity": {}, "bound_state_root_id": {}, "recovery_id": {},
        "recovery_intent_digest": {}, "recovery_result_digest": {},
        "observed_state": {}, "observed_state_digest": {}, "node_identity": {},
        "process_identity": {}, "observed_at": {}, "signer_identity": {},
        "signer_fingerprint": {}, "signature_namespace": {},
        "signed_binding": {}, "sshsig_armored": {}, "capture_digest": {}
      }
    },
    "node_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "role", "permission", "key_identity"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "permission": {"const": "read_only"},
        "key_identity": {"type": "string", "minLength": 1}
      }
    },
    "process_identity": {
      "type": "object", "additionalProperties": false, "required": ["uid", "cgroup"],
      "properties": {
        "uid": {"type": "integer", "minimum": 0},
        "cgroup": {"type": "string", "minLength": 1}
      }
    },
    "unit_state": {
      "type": "object", "additionalProperties": false,
      "required": ["active_state", "unit_file_state", "n_restarts", "invocation_id"],
      "properties": {
        "active_state": {"type": "string", "minLength": 1},
        "unit_file_state": {"type": "string", "minLength": 1},
        "n_restarts": {"type": "integer", "minimum": 0},
        "invocation_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
