{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/pg_observer_bootstrap_intent_v1.schema.json",
  "title": "pg_observer_bootstrap_intent_v1",
  "description": "Exact typed intent for one S2.0 production read-only PG observer bootstrap. The grant set is selected by a structured enum key, never raw SQL. production target_class stays fail-closed (real apply deferred until an exact operator SSHSIG exists in the S2.0 EFFECT session).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "target_class",
    "target_host",
    "endpoint",
    "database",
    "observer_role",
    "auth_mapping",
    "observed_schema",
    "observed_relations",
    "grant_set_selector",
    "ttl_seconds",
    "applier_node_id",
    "postcheck_node_id",
    "created_at",
    "expires_at",
    "source_head",
    "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "pg_observer_bootstrap_intent_v1"},
    "intent_id": {"$ref": "#/$defs/digest"},
    "target_class": {"enum": ["disposable_local", "production"]},
    "target_host": {"type": "string", "minLength": 1},
    "endpoint": {"$ref": "#/$defs/endpoint"},
    "database": {"type": "string", "minLength": 1},
    "observer_role": {"$ref": "#/$defs/pg_ident"},
    "auth_mapping": {"enum": ["pg_hba_ident_local", "pg_hba_peer_local"]},
    "observed_schema": {"$ref": "#/$defs/pg_ident"},
    "observed_relations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pg_ident"}
    },
    "grant_set_selector": {"const": "observer_read_only_v1"},
    "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "applier_node_id": {"type": "string", "minLength": 1},
    "postcheck_node_id": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "pg_ident": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_class", "socket_dir", "loopback_host", "port"],
      "properties": {
        "endpoint_class": {"enum": ["unix_socket_allowlisted", "authenticated_loopback"]},
        "socket_dir": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "loopback_host": {"anyOf": [{"enum": ["127.0.0.1", "::1"]}, {"type": "null"}]},
        "port": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 65535}, {"type": "null"}]}
      }
    }
  }
}
