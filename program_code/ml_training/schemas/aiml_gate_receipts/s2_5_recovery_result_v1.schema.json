{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_5_recovery_result_v1.schema.json",
  "title": "s2_5_recovery_result_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "recovery_id", "recovery_intent_digest", "recovery_intent",
    "recovery_binding",
    "actor_identity", "actor_process", "actor_capture_digest", "actor_capture",
    "rollback_intent_digest", "rollback_result_digest", "rollback_status", "rollback",
    "post_state", "status", "authorization_consumption_proof",
    "result_digest", "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_5_recovery_result_v1"},
    "recovery_id": {"type": "string", "pattern": "^s2-5-recovery-[0-9a-f]{64}$"},
    "recovery_intent_digest": {"$ref": "#/$defs/digest"},
    "recovery_intent": {"$ref": "#/$defs/intent_shape"},
    "recovery_binding": {"$ref": "#/$defs/recovery_binding_shape"},
    "actor_identity": {"$ref": "#/$defs/node_identity"},
    "actor_process": {"$ref": "#/$defs/process_identity"},
    "actor_capture_digest": {"$ref": "#/$defs/digest"},
    "actor_capture": {"$ref": "#/$defs/capture_shape"},
    "rollback_intent_digest": {"$ref": "#/$defs/digest"},
    "rollback_result_digest": {"$ref": "#/$defs/digest"},
    "rollback_status": {"enum": ["ROLLBACK_APPLIED", "ROLLBACK_FAILED", "LATCH_PRESERVED"]},
    "rollback": {"$ref": "#/$defs/rollback_shape"},
    "post_state": {"$ref": "#/$defs/unit_state"},
    "status": {"enum": ["RECOVERY_APPLIED", "RECOVERY_FAILED", "RECOVERY_ABORTED"]},
    "authorization_consumption_proof": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "authorization_id", "recovery_id",
        "recovery_intent_digest", "bound_state_root_id", "external_sequence",
        "previous_append_head_digest", "append_entry_digest", "append_head_digest",
        "append_only", "immutable_readback", "immutable_readback_digest",
        "append_actor_identity", "readback_verifier_identity", "evidence_class",
        "signer_identity", "signer_fingerprint", "signature_namespace",
        "signed_binding", "sshsig_armored", "proof_digest"
      ],
      "properties": {
        "schema_version": {"const": "s2_5_recovery_authorization_consumption_v1"},
        "authorization_id": {"type": "string", "pattern": "^s2-5-recovery-auth-[0-9a-f]{64}$"},
        "recovery_id": {"type": "string", "pattern": "^s2-5-recovery-[0-9a-f]{64}$"},
        "recovery_intent_digest": {"$ref": "#/$defs/digest"},
        "bound_state_root_id": {"type": "string", "minLength": 1},
        "external_sequence": {"type": "integer", "minimum": 1},
        "previous_append_head_digest": {"$ref": "#/$defs/digest"},
        "append_entry_digest": {"$ref": "#/$defs/digest"},
        "append_head_digest": {"$ref": "#/$defs/digest"},
        "append_only": {"const": true},
        "immutable_readback": {"const": true},
        "immutable_readback_digest": {"$ref": "#/$defs/digest"},
        "append_actor_identity": {"type": "string", "minLength": 1},
        "readback_verifier_identity": {"type": "string", "minLength": 1},
        "evidence_class": {"enum": ["LOCAL_REPRODUCIBLE", "PLATFORM_OR_EXTERNAL_ATTESTED"]},
        "signer_identity": {"const": "aiml-s2-5-recovery-consumption-ledger-v1"},
        "signer_fingerprint": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"},
        "signature_namespace": {"const": "arcane-equilibrium-aiml-s2-5-recovery-consumption"},
        "signed_binding": {
          "type": "object", "additionalProperties": false,
          "required": [
            "schema_version", "authorization_id", "recovery_id",
            "recovery_intent_digest", "bound_state_root_id", "external_sequence",
            "previous_append_head_digest", "append_entry_digest", "append_head_digest",
            "append_only", "immutable_readback", "immutable_readback_digest",
            "append_actor_identity", "readback_verifier_identity", "evidence_class"
          ],
          "properties": {
            "schema_version": {"const": "s2_5_recovery_authorization_consumption_v1"},
            "authorization_id": {"type": "string", "pattern": "^s2-5-recovery-auth-[0-9a-f]{64}$"},
            "recovery_id": {"type": "string", "pattern": "^s2-5-recovery-[0-9a-f]{64}$"},
            "recovery_intent_digest": {"$ref": "#/$defs/digest"},
            "bound_state_root_id": {"type": "string", "minLength": 1},
            "external_sequence": {"type": "integer", "minimum": 1},
            "previous_append_head_digest": {"$ref": "#/$defs/digest"},
            "append_entry_digest": {"$ref": "#/$defs/digest"},
            "append_head_digest": {"$ref": "#/$defs/digest"},
            "append_only": {"const": true},
            "immutable_readback": {"const": true},
            "immutable_readback_digest": {"$ref": "#/$defs/digest"},
            "append_actor_identity": {"type": "string", "minLength": 1},
            "readback_verifier_identity": {"type": "string", "minLength": 1},
            "evidence_class": {"enum": ["LOCAL_REPRODUCIBLE", "PLATFORM_OR_EXTERNAL_ATTESTED"]}
          }
        },
        "sshsig_armored": {"type": "string", "minLength": 1},
        "proof_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "result_digest": {"$ref": "#/$defs/digest"},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "recovery_binding_shape": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_digest", "unresolved_state_digest", "state_root_identity",
        "journal_set", "replay_ledger_head", "pre_state", "source_head",
        "host_identity", "host_capture", "host_capture_digest", "authorization",
        "trusted_anchor", "actor_identity", "actor_process",
        "kernel_binding_digest", "admission_digest",
        "side_effect_class", "production_effect", "production_authority",
        "target_class"
      ],
      "properties": {
        "task_digest": {}, "unresolved_state_digest": {}, "state_root_identity": {},
        "journal_set": {}, "replay_ledger_head": {}, "pre_state": {},
        "source_head": {}, "host_identity": {}, "host_capture": {},
        "host_capture_digest": {}, "authorization": {}, "trusted_anchor": {},
        "actor_identity": {}, "actor_process": {},
        "kernel_binding_digest": {}, "admission_digest": {},
        "side_effect_class": {}, "production_effect": {},
        "production_authority": {}, "target_class": {}
      }
    },
    "intent_shape": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "recovery_id", "action", "recovery_binding",
        "actor_identity", "actor_process", "kernel_binding_digest",
        "admission_digest", "intent_digest", "self_digest"
      ],
      "properties": {
        "schema_version": {}, "recovery_id": {}, "action": {},
        "recovery_binding": {}, "actor_identity": {}, "actor_process": {},
        "kernel_binding_digest": {}, "admission_digest": {},
        "intent_digest": {}, "self_digest": {}
      }
    },
    "rollback_shape": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "recovery_id", "recovery_intent_digest", "action",
        "recovery_binding", "actor_identity", "actor_process",
        "actor_capture_digest", "actor_capture", "pre_state", "post_state",
        "status", "rollback_intent_digest", "rollback_result_digest",
        "self_digest"
      ],
      "properties": {
        "schema_version": {}, "recovery_id": {},
        "recovery_intent_digest": {}, "action": {}, "recovery_binding": {},
        "actor_identity": {}, "actor_process": {}, "actor_capture_digest": {},
        "actor_capture": {}, "pre_state": {}, "post_state": {}, "status": {},
        "rollback_intent_digest": {}, "rollback_result_digest": {},
        "self_digest": {}
      }
    },
    "capture_shape": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "capture_kind", "source_head", "host_identity",
        "host_capture_digest", "bound_state_root_id", "recovery_id",
        "recovery_intent_digest",
        "recovery_result_digest", "observed_state", "observed_state_digest",
        "node_identity", "process_identity", "observed_at", "signer_identity",
        "signer_fingerprint", "signature_namespace", "signed_binding",
        "sshsig_armored", "capture_digest"
      ],
      "properties": {
        "schema_version": {}, "capture_kind": {}, "source_head": {},
        "host_identity": {}, "host_capture_digest": {},
        "bound_state_root_id": {}, "recovery_id": {},
        "recovery_intent_digest": {}, "recovery_result_digest": {},
        "observed_state": {}, "observed_state_digest": {}, "node_identity": {},
        "process_identity": {}, "observed_at": {}, "signer_identity": {},
        "signer_fingerprint": {}, "signature_namespace": {},
        "signed_binding": {}, "sshsig_armored": {}, "capture_digest": {}
      }
    },
    "node_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "role", "permission", "key_identity"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "permission": {"const": "effect"},
        "key_identity": {"type": "string", "minLength": 1}
      }
    },
    "process_identity": {
      "type": "object", "additionalProperties": false, "required": ["uid", "cgroup"],
      "properties": {
        "uid": {"type": "integer", "minimum": 0},
        "cgroup": {"type": "string", "minLength": 1}
      }
    },
    "unit_state": {
      "type": "object", "additionalProperties": false,
      "required": ["active_state", "unit_file_state", "n_restarts", "invocation_id"],
      "properties": {
        "active_state": {"type": "string", "minLength": 1},
        "unit_file_state": {"type": "string", "minLength": 1},
        "n_restarts": {"type": "integer", "minimum": 0},
        "invocation_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
