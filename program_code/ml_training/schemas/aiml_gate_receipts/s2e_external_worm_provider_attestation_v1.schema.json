{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2e_external_worm_provider_attestation_v1.schema.json",
  "title": "s2e_external_worm_provider_attestation_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "evidence_class", "provider_class",
    "provider_locator", "external_intent_digest", "external_result_digest",
    "external_readback_ack_digest", "terminal_payload_digest", "destination",
    "immutable_object", "observed_at", "expires_at", "signer",
    "signed_core_digest", "signature", "attestation_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2e_external_worm_provider_attestation_v1"},
    "purpose": {"const": "ATTEST_S2E_EXTERNAL_WORM_IMMUTABLE_READBACK"},
    "evidence_class": {"const": "PLATFORM_OR_EXTERNAL_ATTESTED"},
    "provider_class": {"const": "S3_OBJECT_LOCK_EXTERNAL_ATTESTOR_V1"},
    "provider_locator": {
      "type": "string",
      "minLength": 29,
      "maxLength": 156,
      "pattern": "^aws:s3-object-lock-attestor:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "external_intent_digest": {"$ref": "#/$defs/digest"},
    "external_result_digest": {"$ref": "#/$defs/digest"},
    "external_readback_ack_digest": {"$ref": "#/$defs/digest"},
    "terminal_payload_digest": {"$ref": "#/$defs/digest"},
    "destination": {"$ref": "#/$defs/destination"},
    "immutable_object": {"$ref": "#/$defs/immutable_object"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "signer": {"$ref": "#/$defs/signer"},
    "signed_core_digest": {"$ref": "#/$defs/digest"},
    "signature": {"$ref": "#/$defs/signature"},
    "attestation_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint", "region", "bucket", "credential_channel_id",
        "object_lock_mode", "retain_until"
      ],
      "properties": {
        "endpoint": {"type": "string", "minLength": 1, "maxLength": 1024},
        "region": {"type": "string", "minLength": 1, "maxLength": 128},
        "bucket": {"type": "string", "minLength": 3, "maxLength": 255},
        "credential_channel_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "object_lock_mode": {"const": "COMPLIANCE"},
        "retain_until": {"$ref": "#/$defs/timestamp"}
      }
    },
    "immutable_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_locator", "object_version_id", "checksum_sha256",
        "append_status", "readback_ack", "immutability_proven",
        "object_lock_enabled"
      ],
      "properties": {
        "record_locator": {"type": "string", "minLength": 1, "maxLength": 2048},
        "object_version_id": {"type": "string", "minLength": 1, "maxLength": 2048},
        "checksum_sha256": {"$ref": "#/$defs/digest"},
        "append_status": {"enum": ["APPENDED", "IDEMPOTENT_DEDUP"]},
        "readback_ack": {"const": true},
        "immutability_proven": {"const": true},
        "object_lock_enabled": {"const": true}
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "identity", "namespace", "key_generation", "anchor",
        "key_fingerprint"
      ],
      "properties": {
        "role": {"const": "EXTERNAL_WORM_PROVIDER_ATTESTOR"},
        "identity": {"const": "aiml-s2e-external-worm-provider-attestor-v1"},
        "namespace": {"const": "arcane-equilibrium-aiml-s2e-external-worm-provider"},
        "key_generation": {"const": "independent_off_repo_ed25519_v1"},
        "anchor": {"const": "fixed_off_repo_public_trust_root_v1"},
        "key_fingerprint": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signed_digest", "signature"],
      "properties": {
        "algorithm": {"const": "SSHSIG"},
        "signed_digest": {"$ref": "#/$defs/digest"},
        "signature": {"type": "string", "minLength": 32, "maxLength": 16384}
      }
    }
  }
}
