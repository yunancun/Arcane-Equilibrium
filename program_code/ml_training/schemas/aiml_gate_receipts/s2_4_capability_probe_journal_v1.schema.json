{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_4_capability_probe_journal_v1.schema.json",
  "title": "s2_4_capability_probe_journal_v1",
  "description": "Write-ahead log contract for one S2.4 capability probe (§5.2). Schema only; the W4 effect runner writes it. Before the first transient-unit D-Bus call it records/fsyncs APPLYING with the exact derived unit name, scope, complete property digest, expected InvocationID/cgroup pattern and cleanup rollback digest, then journals unit creation, observation, stop/kill-after-grace, reset-failed/removal and zero-residue verification as separate monotonic-seq transitions. Each entry carries pre/post-state digests and no secret bytes; journal_integrity records the same-filesystem temp-create/file-fsync/atomic-rename/parent-fsync discipline. self_digest is the canonical inner digest; outer_checksum is the separate outer integrity checksum. A WAL, never a retrospective log.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_id",
    "derived_unit_name",
    "scope",
    "transient_unit_property_digest",
    "expected_invocation_id_pattern",
    "cleanup_rollback_digest",
    "entries",
    "terminal",
    "journal_integrity",
    "outer_checksum",
    "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_4_capability_probe_journal_v1"},
    "probe_id": {"$ref": "#/$defs/probe_id"},
    "derived_unit_name": {"$ref": "#/$defs/derived_unit_name"},
    "scope": {"enum": ["PREPARE_SANDBOX", "INSTALLED_UNIT"]},
    "transient_unit_property_digest": {"$ref": "#/$defs/digest"},
    "expected_invocation_id_pattern": {"type": "string", "minLength": 1},
    "cleanup_rollback_digest": {"$ref": "#/$defs/digest"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/journal_entry"}
    },
    "terminal": {"type": "boolean"},
    "journal_integrity": {"$ref": "#/$defs/journal_integrity"},
    "outer_checksum": {"$ref": "#/$defs/digest"},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "probe_id": {"type": "string", "pattern": "^s2-4-probe-[0-9a-f]{64}$"},
    "derived_unit_name": {"type": "string", "pattern": "^arcane-aiml-s2-4-probe-[0-9a-f]{64}\\.service$"},
    "state": {
      "enum": [
        "NOT_STARTED",
        "APPLYING",
        "APPLIED",
        "VERIFYING",
        "VERIFIED",
        "COMPENSATING",
        "COMPENSATED",
        "FAILED"
      ]
    },
    "journal_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "state", "pre_state_digest", "post_state_digest", "fsynced", "recorded_at", "entry_source", "component_effect_class"],
      "properties": {
        "seq": {"type": "integer", "minimum": 0},
        "state": {"$ref": "#/$defs/state"},
        "pre_state_digest": {"$ref": "#/$defs/digest"},
        "post_state_digest": {"$ref": "#/$defs/digest"},
        "fsynced": {"const": true},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "entry_source": {"enum": ["aggregate_transaction", "component_row_driver", "prepare_bundle", "capability_probe"]},
        "component_effect_class": {"type": "string", "minLength": 1}
      }
    },
    "journal_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_filesystem_atomic_rename", "file_fsynced", "parent_dir_fsynced"],
      "properties": {
        "same_filesystem_atomic_rename": {"const": true},
        "file_fsynced": {"const": true},
        "parent_dir_fsynced": {"const": true}
      }
    }
  }
}
