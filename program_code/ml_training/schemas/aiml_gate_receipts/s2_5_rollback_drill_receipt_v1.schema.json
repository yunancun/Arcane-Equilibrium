{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_5_rollback_drill_receipt_v1.schema.json",
  "title": "s2_5_rollback_drill_receipt_v1",
  "description": "Closed rollback receipt for the two S2.5 recovery drills (design §5.3). kind=ROLLBACK_TO_DISABLED proves the failed S2.5A start was fully reversed to the exact S2.4 loaded/disabled/inactive pre-state (bound by s2_4_inactive_prestate_digest); kind=WATCHDOG_RESET_LAST proves the S2.5B watchdog-last predicate (the final lifecycle operation is the authorized reset-failed itself, NRestarts baseline is zero afterwards, and no supervening/unexplained restart occurred). operation is structured (never a raw command string). The embedded watchdog_last block is written out in full here per the PM §5.4 option (b) ruling (no cross-file $ref, no byte-isomorphism coupling): in this receipt it binds the drill operation itself. A rollback that fails stays NOT_RESTORED/FAILED — an unrestored partial state is never converted into success.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "intent_id",
    "unit_name",
    "pre_state",
    "post_state",
    "operation",
    "s2_4_inactive_prestate_digest",
    "watchdog_last",
    "observed_at",
    "expires_at",
    "source_head",
    "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_5_rollback_drill_receipt_v1"},
    "kind": {"enum": ["ROLLBACK_TO_DISABLED", "WATCHDOG_RESET_LAST"]},
    "status": {"enum": ["RESTORED_INACTIVE", "RESET_CLEAN", "NOT_RESTORED", "FAILED"]},
    "intent_id": {"$ref": "#/$defs/start_id"},
    "unit_name": {"const": "arcane-equilibrium-aiml-engine-scanner.service"},
    "pre_state": {"$ref": "#/$defs/unit_state"},
    "post_state": {"$ref": "#/$defs/unit_state"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["systemd_stop_disable", "systemd_reset_failed"]}
      }
    },
    "s2_4_inactive_prestate_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "watchdog_last": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/watchdog_last"}]},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "source_head": {"$ref": "#/$defs/git_sha"},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "ROLLBACK_TO_DISABLED"}}},
      "then": {
        "properties": {
          "operation": {"properties": {"kind": {"const": "systemd_stop_disable"}}},
          "s2_4_inactive_prestate_digest": {"$ref": "#/$defs/digest"},
          "watchdog_last": {"type": "null"},
          "status": {"enum": ["RESTORED_INACTIVE", "NOT_RESTORED", "FAILED"]}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "WATCHDOG_RESET_LAST"}}},
      "then": {
        "properties": {
          "operation": {"properties": {"kind": {"const": "systemd_reset_failed"}}},
          "s2_4_inactive_prestate_digest": {"type": "null"},
          "watchdog_last": {"$ref": "#/$defs/watchdog_last"},
          "status": {"enum": ["RESET_CLEAN", "FAILED"]}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "RESTORED_INACTIVE"}}},
      "then": {
        "properties": {
          "post_state": {
            "properties": {
              "active_state": {"const": "inactive"},
              "unit_file_state": {"const": "disabled"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "RESET_CLEAN"}}},
      "then": {
        "properties": {
          "post_state": {"properties": {"n_restarts": {"const": 0}}},
          "watchdog_last": {
            "properties": {
              "unexplained_restart_detected": {"const": false},
              "last_transition_matches_authorized_op": {"const": true}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "start_id": {"type": "string", "pattern": "^s2-5-[0-9a-f]{64}$"},
    "unit_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_state", "unit_file_state", "n_restarts", "invocation_id"],
      "properties": {
        "active_state": {"type": "string", "minLength": 1},
        "unit_file_state": {"type": "string", "minLength": 1},
        "n_restarts": {"type": "integer", "minimum": 0},
        "invocation_id": {"type": "string", "minLength": 1}
      }
    },
    "watchdog_last": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "watchdog_usec",
        "n_restarts_before",
        "n_restarts_after",
        "invocation_id_before",
        "invocation_id_after",
        "last_lifecycle_operation",
        "last_transition_matches_authorized_op",
        "unexplained_restart_detected"
      ],
      "properties": {
        "watchdog_usec": {"anyOf": [{"const": "none"}, {"type": "integer", "minimum": 1}]},
        "n_restarts_before": {"type": "integer", "minimum": 0},
        "n_restarts_after": {"type": "integer", "minimum": 0},
        "invocation_id_before": {"type": "string", "minLength": 1},
        "invocation_id_after": {"type": "string", "minLength": 1},
        "last_lifecycle_operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["systemd_reset_failed", "systemd_stop_disable", "systemd_enable_now"]}
          }
        },
        "last_transition_matches_authorized_op": {"type": "boolean"},
        "unexplained_restart_detected": {"type": "boolean"}
      }
    }
  }
}
