{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-equilibrium.local/schemas/s2_4_prepare_rollback_v1.schema.json",
  "title": "s2_4_prepare_rollback_v1",
  "description": "Per-row rollback contract for one S2.4 LEARNING_RUNTIME_PREPARE phase (§4 recovery contract, §5.1). Its signed digest is authority only for compensation of that prepare journal's task-owned staging delta, even after apply authority expires: expiry blocks new/resumed apply but never this safety rollback. It compensates only the task-owned staging delta (no age-scan, no separate cleanup shortcut) with a pre/post state digest pair proving exact restoration. status==CLEANED_EXACT requires the task-owned staging delta removed and the staging root absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "prepare_id",
    "staging_root",
    "pre_state_digest",
    "post_state_digest",
    "task_owned_only",
    "staging_delta_removed",
    "staging_absent",
    "observed_at",
    "expires_at",
    "self_digest"
  ],
  "properties": {
    "schema_version": {"const": "s2_4_prepare_rollback_v1"},
    "status": {"enum": ["CLEANED_EXACT", "NOT_CLEANED"]},
    "prepare_id": {"$ref": "#/$defs/prepare_id"},
    "staging_root": {"type": "string", "minLength": 1},
    "pre_state_digest": {"$ref": "#/$defs/digest"},
    "post_state_digest": {"$ref": "#/$defs/digest"},
    "task_owned_only": {"type": "boolean"},
    "staging_delta_removed": {"type": "boolean"},
    "staging_absent": {"type": "boolean"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "self_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "CLEANED_EXACT"}}},
      "then": {
        "properties": {
          "task_owned_only": {"const": true},
          "staging_delta_removed": {"const": true},
          "staging_absent": {"const": true}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "prepare_id": {"type": "string", "pattern": "^s2-4-prepare-[0-9a-f]{64}$"}
  }
}
